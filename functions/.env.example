# =============================================================================
# VOICEUP AI - Cloud Functions environment (SERVER SIDE ONLY)
# -----------------------------------------------------------------------------
# Copy to functions/.env for local emulation, and set the same values in your
# deployed environment:
#   firebase functions:secrets:set GEMINI_API_KEY
# or (simpler, less granular) upload this file with the deployment:
#   firebase deploy --only functions
#
# NOTHING in this file may ever be given a VITE_ prefix or copied into web/.
# =============================================================================

GEMINI_API_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

CUSTOM_AI_ENDPOINT=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_NAME=

DEFAULT_AI_PROVIDER=gemini
FUNCTIONS_REGION=asia-south1
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAILS=

GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_AUDIO_MODEL=gemini-2.0-flash
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-001
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

DAILY_CHAT_LIMIT=300
DAILY_TRANSCRIBE_LIMIT=60
DAILY_TTS_LIMIT=200
