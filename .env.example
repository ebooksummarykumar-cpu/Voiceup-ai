# =============================================================================
# VOICEUP AI - root environment template
# -----------------------------------------------------------------------------
# This file documents EVERY variable the project can use. It contains
# placeholders only. Copy the relevant block into web/.env and
# functions/.env and fill in your own values. Never commit a real key.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIG  ->  web/.env  (public, safe to expose)
# -----------------------------------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Region your Cloud Functions are deployed to (must match functions/.env)
VITE_FUNCTIONS_REGION=asia-south1

# Set to "true" to talk to the local Firebase emulators instead of production
VITE_USE_EMULATORS=false

# -----------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS  ->  functions/.env  (NEVER expose to the browser)
# -----------------------------------------------------------------------------
# Provider API keys. Leave a provider blank to disable it.
GEMINI_API_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# A custom, OpenAI-compatible endpoint (self-hosted, proxy, or another vendor)
CUSTOM_AI_ENDPOINT=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_NAME=

# Default provider when a request does not name one
DEFAULT_AI_PROVIDER=gemini

# Optional model overrides
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_AUDIO_MODEL=gemini-2.0-flash
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-001
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# Cloud Functions behaviour
FUNCTIONS_REGION=asia-south1
ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# Comma separated emails allowed to manage AI providers from the UI
ADMIN_EMAILS=you@example.com

# Per-user daily call budgets (0 = unlimited)
DAILY_CHAT_LIMIT=300
DAILY_TRANSCRIBE_LIMIT=60
DAILY_TTS_LIMIT=200
